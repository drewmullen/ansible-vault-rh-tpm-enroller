[Unit]
Description=Software TPM socket for Vault enrollment
Before=vault-proxy.service

[Service]
User=tss
Group=tss
StateDirectory=swtpm
ExecStart=/usr/bin/swtpm socket --tpm2 --tpmstate dir=/var/lib/swtpm --server type=unixio,path={{ vault_tpm_device_path }} --ctrl type=unixio,path={{ vault_tpm_device_path }}.ctrl --flags not-need-init,startup-clear

[Install]
WantedBy=multi-user.target
