[Unit]
Description=Vault Proxy with TPM auto-auth
After=network-online.target
{% if vault_tpm_install_swtpm | bool %}
After=swtpm.service
{% endif %}
Wants=network-online.target

[Service]
User={{ vault_tpm_proxy_user }}
Group={{ vault_tpm_proxy_user }}
{% if vault_tpm_socket_dir == '/run/vault-proxy' %}
RuntimeDirectory=vault-proxy
RuntimeDirectoryMode=0750
{% endif %}
ExecStart={{ vault_tpm_bin_path }} proxy -config={{ vault_tpm_proxy_config_path }}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
